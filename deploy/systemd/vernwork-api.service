[Unit]
Description=Vernwork FastAPI service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vernwork
Group=www-data
WorkingDirectory=/var/www/vernwork/backend
EnvironmentFile=/etc/vernwork/vernwork.env
ExecStart=/var/www/vernwork/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target